generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model especialidades {
  id                          Int                          @id @default(autoincrement())
  nome                        String                       @unique(map: "nome_UNIQUE") @db.VarChar(150)
  profissional_especialidades profissional_especialidade[]
  consultas                   consultas[]
}

model profissionais {
  id                          Int                          @id @default(autoincrement())
  nome                        String                       @db.VarChar(150)
  email                       String?                      @unique(map: "email_UNIQUE") @db.VarChar(300)
  telefone                    String?                      @unique(map: "telefone_UNIQUE") @db.VarChar(20)
  profissional_especialidades profissional_especialidade[]
  agendas                     agendas[]
  consultas                   consultas[]
}

model profissional_especialidade {
  profissional_id  Int
  especialidade_id Int
  criado_em        DateTime       @db.Date
  profissional     profissionais  @relation(fields: [profissional_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_profissional_has_especialidade_profissional")
  especialidade    especialidades @relation(fields: [especialidade_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_profissional_has_especialidade_especialidade1")

  @@id([profissional_id, especialidade_id])
  @@index([especialidade_id], map: "fk_profissional_has_especialidade_especialidade1_idx")
  @@index([profissional_id], map: "fk_profissional_has_especialidade_profissional_idx")
}

model usuarios {
  id                      Int         @id @default(autoincrement())
  nome                    String      @db.VarChar(150)
  email                   String      @unique(map: "email_UNIQUE") @db.VarChar(255)
  senha_hash              String      @db.Text
  telefone                String?     @db.VarChar(20)
  tipo                    String      @db.VarChar(20)
  data_nascimento         DateTime    @db.Date
  criado_em               DateTime    @db.Date
  agendas_criadas         agendas[]   @relation("AgendaCriador")
  consultas_como_paciente consultas[] @relation("ConsultaPaciente")
}

model agendas {
  id              Int           @default(autoincrement())
  profissional_id Int
  data            DateTime      @db.Date
  horario_inicial DateTime      @db.Time(0)
  horario_final   DateTime      @db.Time(0)
  criado_por      Int
  criado_em       DateTime      @db.Date
  profissional    profissionais @relation(fields: [profissional_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_agendas_profissionais1")
  criador         usuarios      @relation("AgendaCriador", fields: [criado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_agendas_usuarios1")

  @@id([id, profissional_id, criado_por])
  @@index([profissional_id], map: "fk_agendas_profissionais1_idx")
  @@index([criado_por], map: "fk_agendas_usuarios1_idx")
}

model consultas {
  id               Int            @id @default(autoincrement())
  paciente_id      Int
  profissional_id  Int
  especialidade_id Int
  inicio_em        DateTime       @db.DateTime(0)
  fim_em           DateTime       @db.DateTime(0)
  status           String         @db.VarChar(20)
  cancelado_em     DateTime?      @db.Date
  criado_em        DateTime       @db.Date
  paciente         usuarios       @relation("ConsultaPaciente", fields: [paciente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_consultas_usuarios1")
  profissional     profissionais  @relation(fields: [profissional_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_consultas_profissionais1")
  especialidade    especialidades @relation(fields: [especialidade_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_consultas_especialidades1")

  @@index([paciente_id], map: "fk_consultas_usuarios1_idx")
  @@index([profissional_id], map: "fk_consultas_profissionais1_idx")
  @@index([especialidade_id], map: "fk_consultas_especialidades1_idx")
}

model email_jobs {
  id              Int       @id @default(autoincrement())
  destinatario    String    @db.VarChar(320)
  dados           Json
  status          String    @default("pendente") @db.VarChar(20)
  tentativas      Int       @default(0)
  disponivel_em   DateTime  @default(now()) @db.DateTime(3)
  bloqueado_em    DateTime? @db.DateTime(3)
  token_bloqueio  String?   @db.VarChar(36)
  ultimo_erro     String?   @db.Text
  criado_em       DateTime  @default(now()) @db.DateTime(3)
  enviado_em      DateTime? @db.DateTime(3)

  @@index([status, disponivel_em], map: "email_jobs_status_disponivel_idx")
  @@index([status, bloqueado_em], map: "email_jobs_status_bloqueado_idx")
}
